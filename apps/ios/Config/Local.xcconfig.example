// Copy to Local.xcconfig (gitignored) and fill in. Never commit Local.xcconfig.

// Your Apple team ID: Xcode → Settings → Accounts → select your team (10 characters),
// or copy it from Signing & Capabilities after picking your team once.
DEVELOPMENT_TEAM = XXXXXXXXXX

// Anything unique to you, lowercase letters/numbers only. Bundle ID becomes edu.gatech.graption.<this>
DEV_SUFFIX = yourname

// Development tone server. Use your Mac's LAN IP or a wss:// tunnel URL; never commit a token.
// xcconfig treats // as a comment, so spell ws:// as ws:/$()/ here.
// Example local URL: ws:/$()/192.168.1.8:8000
TONE_URL =
TONE_TOKEN =

// Optional xAI key. Siren and alarm banners still show with this empty.
// Spoken replies still speak on-device with this empty, and they are not translated.
// Siren context sends the sound label and a place string, never audio.
// Spoken replies send the typed text, never microphone audio.
XAI_API_KEY =
// XAI_SPEECH_ENGINE = tts
// XAI_SPEECH_ENGINE = voice
// XAI_SIREN_PLACE = Fulton County, near the Georgia Tech campus in Atlanta
// XAI_SIREN_HANDLES = NWS,NWSAtlanta,NWSSPC,GaTechPD,GTPDalerts,Atlanta_Police
